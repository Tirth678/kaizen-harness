{
  "name": "@kaizen-harness/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Kaizen agent core - orchestrates the agent loop and decision making",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "dev": "bun run build --watch",
