    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "dependencies": {
    "@kaizen-harness/model": "workspace:*",
    "@kaizen-harness/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.6",
    "typescript": "^6.0.3"
  }
}